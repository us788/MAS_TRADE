# 실제 값은 .env에 넣는다. .env는 절대 커밋하지 않는다.
# cp .env.example .env
# 소스별 발급 절차·한도·주의사항은 docs/data-sources.md

# ---- LLM (DeepSeek 확정 · 기획서 4절) ----
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# OpenAI ChatCompletions 호환. 벤더 교체는 이 두 줄 변경으로 끝나야 한다.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_DEEP=deepseek-v4-pro
# 재현성을 위해 0 고정 (4.3절). 올리려면 이유를 리뷰 로그에 남긴다.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SEC=300

# ---- 한국 데이터 ----
# DART 전자공시 (무료) https://opendart.fss.or.kr
DART_API_KEY=
# 한국은행 ECOS (무료) https://ecos.bok.or.kr
ECOS_API_KEY=

# ---- 미국 / 글로벌 데이터 ----
# FRED · ALFRED (무료) https://fred.stlouisfed.org
# 매크로는 반드시 ALFRED vintage로 조회한다. 최종 수정치를 쓰면 룩어헤드다.
FRED_API_KEY=
# SEC EDGAR는 키가 없고 User-Agent에 연락처를 요구한다
SEC_USER_AGENT=

# ---- 뉴스 ----
# US 메인: Finnhub company-news (무료 분당 60콜, 개인·비상업 한정) https://finnhub.io
FINNHUB_API_KEY=
# KR 메인: 네이버 검색 API
# developers.naver.com > Application > 애플리케이션 등록 > 사용 API "검색" / 환경 "WEB"
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 센티먼트 베이스라인 전용 (무료 일 25회). 수집기로 쓰지 않는다.
# 펀더멘털 계열(OVERVIEW 등)은 현재 스냅샷만 주므로 시점 정합 불가 — 사용 금지.
ALPHAVANTAGE_API_KEY=

# ---- 실행 설정 ----
# paper 외의 값은 지원하지 않는다. 실주문 경로는 존재하지 않는다.
RUN_MODE=paper
LOG_LEVEL=INFO
