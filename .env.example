# 실제 값은 .env에 넣는다. .env는 절대 커밋하지 않는다.
# cp .env.example .env
# 소스별 발급 절차·한도·시점 정합 여부는 docs/data-sources.md

# =====================================================================
# LLM — DeepSeek 확정 (기획서 4절)
# =====================================================================
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# OpenAI ChatCompletions 호환. 벤더 교체는 이 세 줄 변경으로 끝나야 한다.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_DEEP=deepseek-v4-pro
# 재현성을 위해 0 고정 (4.3절). 올리려면 이유를 리뷰 로그에 남긴다.
LLM_TEMPERATURE=0
LLM_TIMEOUT_SEC=300

# =====================================================================
# 뉴스 — 시장별로 소스가 다르다 (기획서 8절)
# =====================================================================

# --- US 메인: Finnhub company-news ---
# https://finnhub.io  무료 분당 60콜. 개인·비상업 한정이며 기사 본문 재배포 금지.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# --- KR 메인: 네이버 검색 API (뉴스) ---
# 발급처에 따라 도메인·경로·헤더가 전부 다르다. 발급받은 쪽에 맞춰 FLAVOR를 정한다.
#
#   apihub  : NAVER API HUB (네이버 클라우드 플랫폼) — 신규는 이쪽
#             https://naverapihub.apigw.ntruss.com  +  /search/v1/news
#             헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
#   legacy  : 개발자센터 (developers.naver.com) — 지원 종료 예정
#             https://openapi.naver.com  +  /v1/search/news.json
#             헤더 X-Naver-Client-Id / X-Naver-Client-Secret
#
# 무료 한도는 일 25,000건 / 월 775,000건 수준이나 NCP 문서상 "한시적 무료"다.
# 유료 전환 가능성이 있어 빅카인즈를 대체 경로로 준비한다 (docs/data-sources.md).
NAVER_API_FLAVOR=apihub
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 센티먼트 베이스라인 전용: Alpha Vantage NEWS_SENTIMENT ---
# https://www.alphavantage.co  무료 분당 5회 / 일 25회.
# 수집기로 쓰지 않는다. 사전 계산된 종목별 sentiment·relevance를
# LLM 센티먼트 에이전트와 겨룰 제3자 기준선으로만 쓴다 (상위 후보 종목 한정).
# 펀더멘털 계열(OVERVIEW, INCOME_STATEMENT, EARNINGS)은 현재 스냅샷만 주므로 사용 금지.
ALPHAVANTAGE_API_KEY=

# =====================================================================
# 한국 데이터
# =====================================================================
# DART 전자공시 (무료) https://opendart.fss.or.kr
# 재무는 회계기간 종료일이 아니라 접수일자 기준으로 붙인다.
DART_API_KEY=
# 한국은행 ECOS (무료) https://ecos.bok.or.kr
# vintage 조회가 없다. 사후 수정되는 지표는 제한적으로만 쓴다.
ECOS_API_KEY=

# =====================================================================
# 미국 / 글로벌 데이터
# =====================================================================
# FRED · ALFRED (무료) https://fred.stlouisfed.org
# 매크로는 반드시 ALFRED vintage로 조회한다. 최종 수정치를 쓰면 룩어헤드다.
FRED_API_KEY=
# SEC EDGAR는 키가 없고 User-Agent에 연락처를 요구한다 (예: "MAS_TRADE you@example.com")
SEC_USER_AGENT=

# =====================================================================
# 실행 설정
# =====================================================================
# paper 외의 값은 지원하지 않는다. 실주문 경로는 존재하지 않는다.
RUN_MODE=paper
LOG_LEVEL=INFO
